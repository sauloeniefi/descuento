{
  "name": "descuento",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "patch-package",
    "predev": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "prestart": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:import": "node --env-file-if-exists=.env.local scripts/import-sqlite.mjs"
  },
  "dependencies": {
    "next": "16.3.5",
    "pg": "^8.23.0",
    "qrcode-terminal": "^0.12.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "patch-package": "^8.0.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
